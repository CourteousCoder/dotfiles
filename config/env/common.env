EDITOR="$HOME/.local/bin/nvim"
VISUAL="$EDITOR"
#VISUAL="zed"
#VISUAL="codium"

LANG="en_US.UTF-8"
BROWSER="librewolf"

NH_FLAKE="$HOME/.dotfiles"
FLAKE="$NH_FLAKE" # deprecated
#FISH_COMMAND_NOT_FOUND_AUTO_TRY_NIXPKGS=true

VIRTUAL_ENV_DISABLE_PROMPT=true
PYTHONPATH="$HOME/projects:$HOME/venvs"
ANDROID_HOME="$HOME/Android/Sdk"
PNPM_HOME="$HOME/.local/share/pnpm"

FNM_COREPACK_ENABLED=true
FNM_RESOLVE_ENGINES=true
FNM_VERSION_FILE_STRATEGY=recursive
