# vim: set filetype=toml

[init]
	defaultBranch = main
[user]
	name = CourteousCoder
	email = 10914070+CourteousCoder@users.noreply.github.com
	signingkey = FE7A0CB8CC843EE3
[alias]
	ignore = "!gi() { curl -sL https://www.toptal.com/developers/gitignore/api/$@ | tee -a .gitignore ;}; gi"
	unstage = restore --staged
	wt = "worktree"
	wt-ls = "worktree list"
	wt-mv = "worktree move"
	wt-rm = "worktree remove"
	brdel-remote = "! _f() { local remote_branches=\"$(git branch --remotes)\"; test -z \"$remote_branches\" || git branch --delete --remote \"$remote_branches\"; }; _f"
	st = status
	

[core]
	excludesFile = ~/.config/git/ignore
	editor = nvim
	pager = delta

[credential "https://github.com"]
	helper = !~/.nix-profile/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = !~/.nix-profile/bin/gh auth git-credential
[merge]
	ff = only
	autoStash = true
	conflictStyle = zdiff3
[pull]
	ff = only
	autostash = true
[maintenance]
	repo = /home/chloe/Projects/Lola/GTA/GitHub/Bloom-QBOX_miror.git
	repo = /home/chloe/Projects/Lola/GTA/GitHub/Bloom-QBOX.loladrive
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[interactive]
	diffFilter = delta --color-only
	[delta]
	navigate = true

[difftool "difftastic"]
	cmd = difft
[difftool "difft"]
	cmd = difft
[push]
	autoSetupRemote = true

