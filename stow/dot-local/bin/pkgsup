#!/usr/bin/env fish

# FIXME: HACK: my tmpfs on /tmp keeps running out of memory and I don't feel like repartitionings

function pkgsup --description 'Perform a full upgrade of all packages managers'
    sudo printf "Authenticated for sudo\n"
    set -lx TMPDIR ~/.cache/pkgsup
    mkdir -p TMPDIR
    sudo rm -rf /tmp/*
    sudo mount --bind $TMPDIR /tmp

    if command -q apt
        sudoize apt
        apt update -y
        and apt full-upgrade -y
        apt autoremove -y
    end

    if command -q dnf
        sudoize dnf
        dnf check-update
        and dnf upgrade
        dnf autoremove
    end

    if command -q yay
        yay -Syyu --needed --combinedupgrade --noredownload --norebuild --cleanafter --noconfirm
    else if command -q pacman
        sudo pacman -Syyu --needed --combinedupgrade --noredownload --norebuild --cleanafter --noconfirm
    end
    
    if command -q zypper
        sudo zypper ref
        hostnamectl | grep -q 'Tumbleweed'
        and sudo zypper dup --no-confirm --no-recommends 
        or sudo zypper up --no-confirm --no-recommends 
    end

    if command -q flatpak
        flatpak update --noninteractive
        sudo flatpak update --noninteractive
    end

    if command -q pop-upgrade
        pop-upgrade status | grecp -q inactive
        and pop-upgrade recovery check
        # and pop-upgrade release check
        and pop-upgrade release update
        and pop-upgrade cancel
        #and pop-upgrade release; upgrade
    end

    sudo rm -rf /tmp/*
    if command -q nix
        nixup
    end

    sudo umount /tmp
    set -e $TMPDIR
end

pkgsup $argv
