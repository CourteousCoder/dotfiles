[init]
	defaultBranch = main
[user]
	name = Chloe Shetreet
	email = CourteousCoder@gmail.com
[alias]
	ignore = "!gi() { curl -sL https://www.toptal.com/developers/gitignore/api/$@ | tee -a .gitignore ;}; gi"
    
[core]
	excludesFile = ~/.config/git/ignore
	editor = nvim
	pager = delta

[credential "https://github.com"]
	helper = !~/.nix-profile/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = !~/.nix-profile/bin/gh auth git-credential
[merge]
	ff = only
	autoStash = true
	conflictStyle = zdiff3
[pull]
	ff = only
	autostash = true
[maintenance]
	repo = /home/chloe/Projects/Lola/GTA/GitHub/Bloom-QBOX_miror.git
	repo = /home/chloe/Projects/Lola/GTA/GitHub/Bloom-QBOX.loladrive
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true

# vim: set filetype=toml
[difftool "difftastic"]
	cmd = difft
[difftool "difft"]
	cmd = difft
