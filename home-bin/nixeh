#!/usr/bin/env nix-shell
#!nix-shell -i fish
#!nix-shell -p alejandra bat fish git home-manager nh neovim delta

function nix_edit_home
    #set -lx FISH_COMMAND_NOT_FOUND_AUTO_TRY_NIXPKGS true

    set -gq FLAKE;  or set -lx FLAKE "~/.dotfiles"
    set -gq PAGER;  or set -lx PAGER bat
    set -gq EDITOR; or set -lx EDITOR nvim
    

    "$EDITOR" "$FLAKE/home/packages.nix"
    "$EDITOR" "$FLAKE/home/home.nix"
    "$EDITOR" "$FLAKE/flake.nix"
    cd (realpath "$FLAKE")
    alejandra flake.nix home/ lib/

    git diff -U0 -- '*.nix' | delta

    # changes detected, so we update
    nixup
    and return 0
    
    # if we get here then the upgrade must have failed.
    grep --color error "$FLAKE/nh-home-switch.log"
    return 1
end

nix_edit_home $argv
