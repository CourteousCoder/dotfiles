**/*.cache
**/*.log
**/.ssh
# Tag items as ignored by renaming
**/*.ignored.*
# public keys are fine, but will ignore them for now.
#!**.ssh/*.pub

# gh / glab CLI configs gain runtime OAuth tokens on auth — never track them.
# Files stay on disk (out-of-store symlink targets); a fresh clone just re-auths.
config/gh/hosts.yml
config/glab-cli/aliases.yml

# zoom configs may contain creds (moved here from the deleted config/.gitignore)
config/zoom.conf
config/zoomus.conf

# nix build symlinks
result
result-*

# python bytecode caches (e.g. thefuck)
**/__pycache__/

config/KDE/neochat.conf

